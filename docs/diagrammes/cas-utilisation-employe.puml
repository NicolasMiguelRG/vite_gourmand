    usecase "Gérer les menus" as UC3
    usecase "Publier un menu" as UC13
    usecase "Gérer les plats" as UC4
    usecase "Gérer les régimes et les thèmes" as UC14
    usecase "Modifier les horaires" as UC5
    usecase "Consulter les commandes" as UC6
    usecase "Filtrer les commandes" as UC7
    usecase "Mettre à jour le statut d'une commande" as UC8
    usecase "Modifier la commande d'un client" as UC9
    usecase "Saisir le mode de contact et le motif" as UC11
    usecase "Annuler la commande d'un client" as UC10
    usecase "Modérer les avis" as UC12
    usecase "Retirer un avis validé" as UC15
}

